# ============================================================================
# Dynasty 8 — variables d'environnement (pack Docker « vps »)
# ----------------------------------------------------------------------------
# Copier ce fichier en « .env » dans ce même dossier (deploy/vps/), puis le
# remplir. Le .env est exclu de Git : il ne doit JAMAIS être commité.
# Tout ce qui est secret, propre au serveur ou à l'infrastructure vit ici ;
# les liens métier (WebMap, Google Sheets, Discord de l'agence…) se règlent
# dans l'espace agents, onglet Paramètres.
# ============================================================================

# --- Port local relayé par nginx (sur l'hôte) ---
# Doit correspondre au proxy_pass de nginx-dynasty8.conf (127.0.0.1:3010).
PORT_LOCAL=3010

# --- PostgreSQL (base interne au réseau Docker, jamais exposée) ---
# Compte ADMINISTRATEUR : utilisé UNIQUEMENT par le service « migration »
# (application du schéma). Le site ne reçoit jamais ce mot de passe.
POSTGRES_USER=dynasty8
POSTGRES_PASSWORD=
POSTGRES_DB=dynasty8
# Compte APPLICATIF restreint (SELECT, INSERT, UPDATE, DELETE uniquement) :
# c'est avec lui que tourne le site. Créé et mis à jour par la migration.
# Mot de passe : lettres et chiffres uniquement (il entre dans une URL).
APP_DB_USER=dynasty8_app
APP_DB_PASSWORD=
# PostgreSQL interne, sans TLS.
PGSSL=disable

# --- Session (signature des cookies de connexion) — OBLIGATOIRE ---
# Valeur longue et aléatoire, par ex. : openssl rand -hex 32
# Le serveur refuse de démarrer si elle est vide ou trop courte.
SESSION_SECRET=

# --- Adresse publique du site (facultatif) ---
# Sert aux balises de partage (aperçu Discord, réseaux). Vide = l'adresse par
# laquelle le visiteur arrive. Exemple : https://dynasty8.exemple.fr
SITE_URL_PUBLIQUE=

# --- Connexion Discord de l'espace agents (application « RoxwoodLegal ») ---
# L'URL de redirection doit être déclarée À L'IDENTIQUE dans le portail
# développeur Discord (application → OAuth2 → Redirects).
DISCORD_CLIENT_ID=1546523997980852294
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://ADRESSE-DU-SITE/api/auth/discord/callback

# --- Bots Discord ---
# Clé du bot de ventes (POST /api/stats/ventes).
STATS_BOT_SECRET=
# Secret de l'abonnement webhook « Candidatures » du bot Roxwood Network
# (affiché UNE seule fois par le bot, panneau Monitoring → Ajouter un webhook).
# URL de l'abonnement : https://<adresse du site>/api/rh/bot/candidatures
# Vide = réception désactivée. Voir notes/bot-recrutement-configuration.md.
RECRUTEMENT_WEBHOOK_SECRET=
# Jeton du bot Discord Roxwood Network (Developer Portal → Bot → Token).
# Le site s'en sert pour LIRE le salon des prises et fins de service
# (encadré « En service » ; ID du salon réglé dans l'onglet Paramètres) et
# pour POSTER les événements « Perso » de l'agenda dans le ticket de la
# personne. Le bot doit voir ces salons, leurs anciens messages, et pouvoir
# écrire dans les tickets. Secret : jamais dans Git. Vide = ces deux
# fonctions désactivées.
DISCORD_BOT_TOKEN=
# ID du serveur Discord de l'agence (clic droit sur le serveur → Copier
# l'identifiant). Sert à lire les rôles de chacun à la connexion (visibilité
# de l'agenda) et à retrouver les tickets. Vide = rôles non lus.
DISCORD_GUILD_ID=

# --- Stockage des photos (CDN storage.fbfa.fr) ---
# Les DEUX valeurs sont nécessaires ; sans elles, l'envoi de photos est
# indisponible (l'espace agents l'indique). Jeton fourni par l'opérateur :
# reste côté serveur, jamais journalisé.
FBFA_STORAGE_BASE=https://storage.fbfa.fr
FBFA_STORAGE_TOKEN=
# Facultatif (valeurs par défaut entre parenthèses) :
# FBFA_STORAGE_PREFIXE=dynasty8        (dossier des fichiers : dynasty8/biens/AAAA/MM/…)
# FBFA_PHOTO_TAILLE_MAX=8388608        (octets par photo)
# FBFA_STORAGE_DELAI_MS=15000          (délai maximal d'un appel au stockage)
# FBFA_IMPORTS_EN_ATTENTE_MAX=40       (photos importées non enregistrées, par membre)
# Nettoyage différé des photos abandonnées ou retirées :
#   simulation (défaut) = journalise seulement ; actif = supprime réellement ; desactive
# NE PASSER à « actif » qu'après accord de la Direction.
# FBFA_NETTOYAGE=simulation
# FBFA_NETTOYAGE_DELAI_HEURES=24

# --- Ordinateur en jeu (FolkOS, FlashbackFA) ---
# Hôte du SDK de l'ordinateur en jeu (clavier, touche Échap, suivi d'adresse).
# Valeur fournie par l'opérateur. Vide = SDK non chargé en jeu.
FOLKOS_SDK_ORIGINE=https://computer.game.fbfa.fr
# Sites autorisés à afficher Dynasty 8 dans un cadre (CSP frame-ancestors),
# séparés par des espaces, en plus du site lui-même. Vide = le site ne
# s'affiche PAS dans l'ordinateur en jeu.
FRAME_ANCESTORS=https://*.fbfa.fr https://fbfa.fr https://cfx-nui-external-iframe nui://game nui:
# Connexion « Se connecter IG » (valeurs de l'opérateur). Le validateur `id`
# doit être joignable depuis le conteneur.
FOLKOS_ID_BASE=
FOLKOS_CLIENT_ID=
FOLKOS_CLIENT_SECRET=

# --- Sécurité et limites (facultatif) ---
# Origines admises en écriture en plus du site lui-même, séparées par des
# virgules (ex. https://autre-domaine.fr). Vide = le site seul.
ORIGINES_AUTORISEES=
# Taille maximale d'une requête /api en octets (défaut 33554432 = 32 Mio).
# Si vous la changez, alignez client_max_body_size dans nginx-dynasty8.conf.
# API_TAILLE_CORPS_MAX=33554432

# --- Tant que le site est servi en HTTP simple (pas encore de certificat) ---
# Cookies sans l'attribut Secure. À RETIRER dès que le site passe en HTTPS.
COOKIES_HTTP=1

# --- Anciennes variables (ne plus les ajouter) ---
# WEBMAP_ORIGIN, GOOGLE_SHEET_ID et GOOGLE_SHEET_GID se règlent désormais dans
# l'onglet Paramètres ; s'ils sont encore présents, leur valeur y est recopiée
# une fois au démarrage, puis ils peuvent être retirés. COHERENCES_SHEET_URL
# n'est plus utilisée.
