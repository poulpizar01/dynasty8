# Copier ce fichier en ".env" (dans ce même dossier deploy/vps/) et remplir
# les vraies valeurs. ".env" est exclu de Git — ne jamais y renoncer.

# Port local sur lequel nginx (sur l'hôte) relaie le site.
PORT_LOCAL=3010

# --- PostgreSQL (base interne, jamais exposée publiquement) ---
# Compte ADMINISTRATEUR de la base : utilisé UNIQUEMENT par le service
# « migration » (application du schéma), jamais par le site lui-même.
POSTGRES_USER=dynasty8
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_long_et_aleatoire
POSTGRES_DB=dynasty8

# --- Compte applicatif restreint (OBLIGATOIRE) ---
# Le site tourne avec ce compte, qui n'a que SELECT, INSERT, UPDATE et DELETE :
# il ne peut ni créer ni supprimer de table. Le service « migration » du
# compose le crée (et met à jour son mot de passe) à chaque démarrage, en
# utilisant le compte administrateur ci-dessus.
# Mot de passe : lettres et chiffres uniquement (il entre dans une URL).
APP_DB_USER=dynasty8_app
APP_DB_PASSWORD=remplacer_par_un_mot_de_passe_long_et_aleatoire

# --- Session (signature des cookies de connexion) ---
# Générer une valeur aléatoire, ex. : openssl rand -hex 32
SESSION_SECRET=remplacer_par_une_valeur_aleatoire_longue

# --- OAuth Discord (mêmes valeurs que sur Railway, ou une nouvelle appli
# Discord dédiée au VPS si vous préférez séparer les deux) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://51.255.173.188/api/auth/discord/callback

# --- Clé du bot de ventes (même valeur que STATS_BOT_SECRET sur Railway,
# ou une nouvelle si vous voulez pouvoir la révoquer indépendamment) ---
STATS_BOT_SECRET=

# --- Bot Discord « Roxwood Network Entreprise » (onglet « Bot Roxwood Network », lecture seule) ---
# Un secret PAR abonnement webhook créé dans le panneau « Monitoring » du bot
# (bouton « Ajouter un webhook », secret affiché une seule fois), séparés par
# des virgules. Vide = l'onglet affiche « Réception non configurée ».
# Voir notes/bot-roxwood-configuration.md.
ROXWOOD_WEBHOOK_SECRETS=

# --- Stockage externe des photos (storage.fbfa.fr) ---
# Jeton fourni par l'opérateur : reste côté serveur, jamais journalisé.
# Vide = import de photos désactivé (l'ajout par lien reste possible).
FBFA_STORAGE_TOKEN=
# Facultatif (défauts) : FBFA_STORAGE_PREFIXE=dynasty8, FBFA_PHOTO_TAILLE_MAX=8388608,
# FBFA_STORAGE_DELAI_MS=15000, FBFA_IMPORTS_EN_ATTENTE_MAX=40,
# FBFA_NETTOYAGE=simulation (simulation | actif | desactive — « actif » seulement
# après accord de la Direction), FBFA_NETTOYAGE_DELAI_HEURES=24.
# Ne pas définir FBFA_STORAGE_BASE en production.


# --- SSO FolkOS (« Se connecter IG » depuis l'ordinateur en jeu) ---
# Valeurs fournies par l'opérateur FlashbackFA. Le validateur `id` écoute en
# 127.0.0.1 : le site DOIT tourner sur le même VPS que FolkOS.
FOLKOS_ID_BASE=
FOLKOS_CLIENT_ID=
FOLKOS_CLIENT_SECRET=

# Tant que le VPS est en HTTP simple (pas de domaine ici) :
COOKIES_HTTP=1
PGSSL=disable
