# Dynasty 8 — variables d'environnement (copier en .env, jamais commité)

# Port local sur lequel le reverse proxy relaie dynasty8.fbfa.fr
PORT_LOCAL=3010

# --- PostgreSQL (interne au réseau Docker) ---
POSTGRES_USER=dynasty8
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_long_et_aleatoire
POSTGRES_DB=dynasty8
PGSSL=disable

# --- Signature des cookies de session : openssl rand -hex 32 ---
SESSION_SECRET=remplacer_par_une_valeur_aleatoire_longue

# --- Connexion Discord de l'espace agents (fournis par Dynasty 8) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://dynasty8.fbfa.fr/api/auth/discord/callback

# --- Clé du bot de ventes Discord (fournie par Dynasty 8) ---
STATS_BOT_SECRET=

# --- Stockage externe des photos (storage.fbfa.fr) ---
# Jeton fourni par l'opérateur : reste côté serveur, jamais journalisé.
# Vide = import de photos désactivé (l'ajout par lien reste possible).
FBFA_STORAGE_TOKEN=
# Réglages facultatifs (valeurs par défaut entre parenthèses) :
# FBFA_STORAGE_PREFIXE=dynasty8        (dossier des fichiers : dynasty8/biens/AAAA/MM/…)
# FBFA_PHOTO_TAILLE_MAX=8388608        (octets par photo)
# FBFA_STORAGE_DELAI_MS=15000          (délai maximal d'un appel au stockage)
# FBFA_IMPORTS_EN_ATTENTE_MAX=40       (photos importées non enregistrées, par membre)
# Nettoyage différé des photos abandonnées ou retirées :
#   simulation (défaut) = journalise seulement ; actif = supprime réellement ; desactive
# NE PASSER à « actif » qu'après accord de la Direction (voir README-OPERATEUR.md).
# FBFA_NETTOYAGE=simulation
# FBFA_NETTOYAGE_DELAI_HEURES=24
# Ne pas définir FBFA_STORAGE_BASE en production (https://storage.fbfa.fr par défaut).

# --- SSO FolkOS « Se connecter IG » (valeurs de l'opérateur) ---
# `id` écoute en 127.0.0.1 sur l'hôte : depuis le conteneur, utiliser
# host.docker.internal (voir compose.yaml). Exemple : http://host.docker.internal:4000
FOLKOS_ID_BASE=
FOLKOS_CLIENT_ID=
FOLKOS_CLIENT_SECRET=
