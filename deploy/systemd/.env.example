# ============================================================================
# Dynasty 8 — secrets et réglages (installation systemd, sans Docker)
# ----------------------------------------------------------------------------
# À copier à la RACINE du dépôt :
#     cp deploy/systemd/.env.example /chemin/vers/dynasty8/.env
#     chmod 600 /chemin/vers/dynasty8/.env
# Ce fichier est lu par systemd (EnvironmentFile) : une ligne = CLE=valeur,
# sans guillemets et sans export. Il ne doit JAMAIS être commité.
#
# PORT, NODE_ENV et DB_SCHEMA_AUTO sont imposés par l'unité systemd
# (deploy/systemd/deploy.sh) : inutile de les mettre ici.
# ============================================================================

# --- PostgreSQL : compte APPLICATIF restreint (le site tourne avec celui-ci) ---
# Droits SELECT / INSERT / UPDATE / DELETE uniquement : aucune création de table.
DATABASE_URL=postgres://dynasty8_app:motdepasse@127.0.0.1:5432/dynasty8

# --- PostgreSQL : compte ADMINISTRATEUR (migrations seulement) ---
# Utilisé uniquement par « npm run migrate » / « deploy.sh migrer ».
# Peut rester vide sur le serveur si les migrations sont lancées ailleurs.
DATABASE_URL_ADMIN=postgres://dynasty8_admin:motdepasse@127.0.0.1:5432/dynasty8
# Compte applicatif créé/mis à jour par la migration.
APP_DB_USER=dynasty8_app
APP_DB_PASSWORD=motdepasse
# PostgreSQL local, sans TLS :
PGSSL=disable

# --- Signature des cookies de session : openssl rand -hex 32 ---
SESSION_SECRET=

# --- Connexion Discord de l'espace agents (application RoxwoodLegal) ---
DISCORD_CLIENT_ID=1546523997980852294
DISCORD_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à une URL de redirection déclarée dans
# l'application Discord RoxwoodLegal (portail développeur → OAuth2).
DISCORD_REDIRECT_URI=https://dynasty8.exemple.fr/api/auth/discord/callback

# --- Clé du bot de ventes (POST /api/stats/ventes) ---
STATS_BOT_SECRET=

# --- Webhooks du bot Roxwood Network Entreprise (séparés par des virgules) ---
ROXWOOD_WEBHOOK_SECRETS=

# --- SSO FolkOS (« Se connecter IG » depuis l'ordinateur en jeu) ---
FOLKOS_ID_BASE=
FOLKOS_CLIENT_ID=
FOLKOS_CLIENT_SECRET=

# --- Stockage externe des photos (storage.fbfa.fr) ---
FBFA_STORAGE_TOKEN=
# Facultatif : FBFA_STORAGE_PREFIXE, FBFA_PHOTO_TAILLE_MAX, FBFA_STORAGE_DELAI_MS,
# FBFA_IMPORTS_EN_ATTENTE_MAX, FBFA_NETTOYAGE (simulation par défaut), FBFA_NETTOYAGE_DELAI_HEURES.

# --- Tant que le site est servi en HTTP simple (pas encore de certificat) ---
# COOKIES_HTTP=1
