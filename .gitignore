node_modules/
*.log

# Secrets réels : JAMAIS dans Git, quel que soit le pack de déploiement.
# Ils sont transmis à l'opérateur hors dépôt (message privé chiffré).
deploy/vps/.env
deploy/operateur/.env
deploy/vps/backups/

# Sauvegardes et dumps de la base : données réelles des membres et des ventes
# (noms RP, journaux). Transmis hors dépôt, jamais commités — voir
# deploy/operateur/README-OPERATEUR.md, section « Reprise des données ».
*.dump
*.sql.gz
*.backup

Claude outputs/
_a-envoyer/
# Comptes rendus des scripts (migration / nettoyage des photos)
rapports/

# Réglages locaux du déploiement systemd (chemins, utilisateur)
deploy/systemd/deploy.conf

# Serveur cible du script de mise en ligne (adresse SSH du VPS du moment)
deploy/vps/cible.bat

# Reglages personnels du lancement en local (identifiants Discord, jetons)
local.bat
