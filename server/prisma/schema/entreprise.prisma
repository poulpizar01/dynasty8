// ENTREPRISE (personnalisable) — tables propres à ce site. Le générateur et la base sont déclarés dans socle.prisma.
// Règles :
// - noms de tables en français et en snake_case (@@map), colonnes aussi (@map) ;
// - un compte se référence par `compteId Int @map("compte_id")`, sans relation Prisma vers Compte (socle.prisma ne se
//   modifie pas) ; ce qui doit disparaître avec le compte est effacé dans avantSuppressionCompte (src/entreprise/index.ts) ;
// - après chaque modification : docker compose exec app npx prisma migrate dev --name <description>, puis committer
//   le dossier créé dans prisma/migrations/.

// Exemple : annonces internes (page gestion/annonces.html, routes src/entreprise/routes/annonces.ts). À supprimer
// ou remplacer par les tables de l'entreprise (stocks, factures, rendez-vous…).
model Annonce {
  id       Int       @id @default(autoincrement())
  compteId Int?      @map("compte_id") // auteur ; null si son compte a été supprimé
  titre    String    @db.VarChar(120)
  texte    String    @db.VarChar(4000)
  epingle  Boolean   @default(false)
  creeLe   DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([creeLe(sort: Desc)])
  @@index([compteId])
  @@map("annonces")
}

// Comptabilité (page gestion/comptabilite.html, routes src/entreprise/routes/compta.ts, calculs src/entreprise/compta/).
// Commune aux entreprises du serveur : relevé Tablettes, déclaration DOT, salaire par grade. La part variable de la
// rémunération (primes, commissions) dépend de chaque entreprise : src/entreprise/compta/remuneration.ts.

// Relevé collé (Tablettes) : le navigateur le découpe, le serveur revalide et garde CHAQUE import (rien n'est écrasé ;
// réinitialiser ou retirer une ligne enregistre un nouvel import). Seul le plus récent est lu.
model ImportCompta {
  id        Int      @id @default(autoincrement())
  type      String   @default("tablettes") @db.VarChar(20)
  colonnes  Json
  lignes    Json
  compteId  Int?     @map("compte_id") // auteur ; null si son compte a été supprimé
  importeLe DateTime @default(now()) @map("importe_le") @db.Timestamptz(6)

  @@index([type, importeLe(sort: Desc)])
  @@index([compteId])
  @@map("compta_imports")
}

// Dépense déductible ou retrait de la semaine, saisis à la main pour la déclaration DOT.
model EcritureDot {
  id           Int      @id @default(autoincrement())
  type         String   @db.VarChar(10) // depense | retrait
  dateEcriture String   @default("") @map("date_ecriture") @db.VarChar(10) // JJ/MM/AAAA
  justificatif String   @db.VarChar(200)
  montant      Int
  compteId     Int?     @map("compte_id")
  creeLe       DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([type])
  @@index([compteId])
  @@map("compta_dot_ecritures")
}

// Barème d'imposition de la DOT (fixé par l'organisme du serveur RP, le même pour toutes les entreprises) : rempli par
// la migration, à corriger en base s'il change.
model BaremeImposition {
  id                Int   @id @default(autoincrement())
  seuilMin          Int   @map("seuil_min")
  seuilMax          Int   @map("seuil_max")
  taux              Float
  salaireMaxEmploye Int   @map("salaire_max_employe")
  salaireMaxPatron  Int   @map("salaire_max_patron")
  primeMaxEmploye   Int   @map("prime_max_employe")
  primeMaxPatron    Int   @map("prime_max_patron")

  @@map("dot_bareme_imposition")
}

// Rémunération par grade (Comptabilité → Rémunération) : salaire fixe de la semaine (versé si salaireActif) et taux
// horaire (heures de service du relevé × taux ; 0 = pas de paie à l'heure). Un grade sans ligne : rien de versé.
model RemunerationGrade {
  gradeCle     String  @id @map("grade") @db.VarChar(20)
  salaireFixe  Int     @default(0) @map("salaire_fixe")
  salaireActif Boolean @default(false) @map("salaire_actif")
  tauxHoraire  Int     @default(0) @map("taux_horaire")

  @@map("remunerations_grades")
}
