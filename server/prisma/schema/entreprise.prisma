// ENTREPRISE (personnalisable) — tables propres à ce site. Le générateur et la base sont déclarés dans socle.prisma.
// Règles :
// - noms de tables en français et en snake_case (@@map), colonnes aussi (@map) ;
// - un compte se référence par `compteId Int @map("compte_id")`, sans relation Prisma vers Compte (socle.prisma ne se
//   modifie pas) ; ce qui doit disparaître avec le compte est effacé dans avantSuppressionCompte (src/entreprise/index.ts) ;
// - après chaque modification : docker compose exec app npx prisma migrate dev --name <description>, puis committer
//   le dossier créé dans prisma/migrations/.

// Bien immobilier proposé par l'agence (catalogue public de la vitrine, géré depuis la gestion).
// Valeurs contrôlées par src/entreprise/biens.ts (catégories, sous-catégories, cohérences).
model Bien {
  id             Int       @id @default(autoincrement())
  categorie      String    @db.VarChar(20) // habitation | garage
  sousCategorie  String?   @map("sous_categorie") @db.VarChar(40)
  titre          String    @db.VarChar(120)
  zone           String?   @db.VarChar(80)
  prix           Int       @default(0)
  prixLocation   Int?      @map("prix_location")
  dispoVente     Boolean   @default(true) @map("dispo_vente")
  dispoLocation  Boolean   @default(false) @map("dispo_location")
  places         Int?
  description    String?   @db.VarChar(4000)
  images         String[]  @default([]) // adresses des photos, dans l'ordre d'affichage
  coupDeCoeur    Boolean   @default(false) @map("coup_de_coeur")
  disponible     Boolean   @default(true) // visible sur le site public
  vendu          Boolean   @default(false)
  venduLe        DateTime? @map("vendu_le") @db.Timestamptz(6)
  meuble         Boolean   @default(true)
  coherence      String?   @db.VarChar(20)
  coffreKg       Int?      @map("coffre_kg")
  vip            Boolean   @default(false)
  standing       Boolean   @default(false)
  auteur         String?   @db.VarChar(64) // nom affiché de l'agent qui a créé l'annonce (gardé après son départ)
  compteId       Int?      @map("compte_id") // agent qui a créé l'annonce ; null si son compte a été supprimé
  creeLe         DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe          DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([categorie])
  @@index([disponible])
  @@index([compteId])
  @@map("biens")
}

// Profil public d'un agent (page Équipe de la vitrine), un par compte.
model Profil {
  compteId   Int     @id @map("compte_id")
  poste      String? @db.VarChar(80) // à défaut : le libellé du grade
  specialite String? @db.VarChar(100)
  bio        String? @db.VarChar(1000)
  photo      String? @db.VarChar(512) // adresse de la photo (stockage d'images)

  @@map("profils")
}

// Photo envoyée par un agent (fichier ou lien téléchargé par le serveur), stockée par le socle (disque en dev, CDN en
// prod). Suivie ici pour être retirée du stockage quand plus rien ne l'utilise : une photo envoyée puis abandonnée
// (annonce jamais enregistrée) ou retirée d'une annonce passe « a_supprimer », et la tâche de nettoyage
// (entreprise/photos.ts) l'efface du stockage avant d'effacer la ligne.
model Photo {
  id       Int      @id @default(autoincrement())
  usage    String   @db.VarChar(10) // bien | profil
  cle      String   @db.VarChar(200)
  url      String   @unique @db.VarChar(512)
  cleMini  String   @map("cle_mini") @db.VarChar(200)
  urlMini  String   @map("url_mini") @db.VarChar(512)
  statut   String   @default("temporaire") @db.VarChar(12) // temporaire | attachee | a_supprimer
  bienId   Int?     @map("bien_id") // bien qui l'affiche (usage bien)
  compteId Int?     @map("compte_id") // agent qui l'a envoyée ; pour un profil, son propriétaire
  erreur   String?  @db.VarChar(300) // dernier échec de suppression sur le stockage
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe    DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([statut, majLe])
  @@index([bienId])
  @@map("photos")
}

// Messagerie interne : conversations privées entre deux agents (widget de la gestion, routes/messagerie.ts).
model Message {
  id             Int      @id @default(autoincrement())
  expediteurId   Int      @map("expediteur_id")
  destinataireId Int      @map("destinataire_id")
  type           String   @default("texte") @db.VarChar(10) // texte | clin_oeil
  contenu        String   @default("") @db.VarChar(1000)
  lu             Boolean  @default(false)
  envoyeLe       DateTime @default(now()) @map("envoye_le") @db.Timestamptz(6)

  @@index([expediteurId, destinataireId])
  @@index([destinataireId, expediteurId])
  @@map("messages")
}

// Statut choisi dans la messagerie (disponible, absent, occupé, invisible). La présence en ligne et l'indicateur
// « en train d'écrire », éphémères, restent en mémoire du serveur.
model StatutMessagerie {
  compteId Int    @id @map("compte_id")
  statut   String @default("disponible") @db.VarChar(12)

  @@map("messagerie_statuts")
}

// « Mon agenda » : événements personnels d'un agent, visibles de lui seul (routes/agenda.ts).
model EvenementAgenda {
  id         Int      @id @default(autoincrement())
  compteId   Int      @map("compte_id")
  titre      String   @db.VarChar(80)
  jour       DateTime @db.Date
  heureDebut String   @map("heure_debut") @db.VarChar(5) // HH:MM
  heureFin   String   @map("heure_fin") @db.VarChar(5)
  notes      String   @default("") @db.VarChar(500)
  creeLe     DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe      DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([compteId, jour])
  @@map("evenements_agenda")
}

// Ressources humaines : la fiche employé, source de vérité de l'identité (routes/rh.ts). Les autres modules (ventes,
// tableur, DOT) ne gardent que employeId et lisent ici nom, grade et statut. Une fiche n'est jamais supprimée : un départ
// la passe « inactif », son historique reste rattaché. Un employé n'a pas forcément de compte sur le site : le lien
// avec un compte se fait par l'ID Discord.
model Employe {
  id                     Int       @id @default(autoincrement())
  idEmploye              String    @map("id_employe") @db.VarChar(40) // identifiant métier saisi par RH (ex. D8-0042)
  idEmployeNormalise     String    @unique @map("id_employe_normalise") @db.VarChar(40) // unicité sans casse
  idProvisoire           Boolean   @default(false) @map("id_provisoire") // PROV-… : à remplacer par le vrai
  prenom                 String    @default("") @db.VarChar(60)
  nom                    String    @default("") @db.VarChar(60)
  telephone              String    @default("") @db.VarChar(30) // donnée sensible (permission rh-sensible)
  rib                    String    @default("") @db.VarChar(60) // donnée sensible (permission rh-sensible)
  discordId              String?   @unique @map("discord_id") @db.VarChar(22)
  discordPseudo          String    @default("") @map("discord_pseudo") @db.VarChar(100) // pseudo envoyé avec les ventes
  discordPseudoNormalise String?   @unique @map("discord_pseudo_normalise") @db.VarChar(100)
  gradeCle               String    @map("grade") @db.VarChar(20) // clé d'un grade du site (page Grades)
  statut                 String    @default("actif") @db.VarChar(8) // actif | inactif
  dateArrivee            DateTime? @map("date_arrivee") @db.Date
  dateDepart             DateTime? @map("date_depart") @db.Date
  creeLe                 DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe                  DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([statut, gradeCle])
  @@map("employes")
}

// Candidature reçue du bot Discord (webhook recruitment.updated), une ligne par ticket : un renvoi du même ticket ne
// crée jamais une deuxième fiche. resultat : creee | existante | refusee (« à traiter », réglage manquant…) |
// attente (embauche constatée en jeu, à approuver) | ecartee. « reponses » (qui peuvent contenir téléphone et RIB) n'est
// gardé que pour un ticket en suspens, 30 jours au plus.
model ArriveeBot {
  id        Int      @id @default(autoincrement())
  ticketId  String   @unique @map("ticket_id") @db.VarChar(100)
  discordId String   @default("") @map("discord_id") @db.VarChar(30)
  nomRecu   String   @default("") @map("nom_recu") @db.VarChar(130)
  resultat  String   @db.VarChar(10)
  motif     String   @default("") @db.VarChar(400)
  employeId Int?     @map("employe_id")
  reponses  Json?
  accepteLe String   @default("") @map("accepte_le") @db.VarChar(40)
  recuLe    DateTime @default(now()) @map("recu_le") @db.Timestamptz(6)

  @@index([recuLe(sort: Desc)])
  @@map("rh_arrivees_bot")
}
